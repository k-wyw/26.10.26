<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
          Title="Заказ пиццы" Height="800" Width="1000">
    <Grid Margin="20">

        <Grid.Background>
            <ImageBrush ImageSource="/back/pngtree-pizza-cartoon-simple-background-picture-image_1283033.jpg" 
                    Stretch="UniformToFill"/>
        </Grid.Background>

        <TextBlock Text="Заказ пиццы" 
               FontSize="32" FontWeight="Bold" 
               HorizontalAlignment="Center" 
               Margin="0,0,0,10"/>

        <TextBlock Text="Размер:" FontSize="20" Margin="206,73,-146,0" VerticalAlignment="Top"/>
        <StackPanel Margin="306,73,-146,0" VerticalAlignment="Top">
            <RadioButton FontSize="16" Content="Маленькая" />
            <RadioButton FontSize="16" Content="Средняя" IsChecked="True" />
            <RadioButton FontSize="16" Content="Большая" />
        </StackPanel>

        <TextBlock Text="Добавки:" FontSize="20" Margin="206,173,-146,0" VerticalAlignment="Top"/>
        <StackPanel Margin="306,173,-146,0" VerticalAlignment="Top">
            <CheckBox FontSize="16" Content="Сыр" Margin="0,0,0,5"/>
            <CheckBox FontSize="16" Content="Грибы" Margin="0,0,0,5"/>
            <CheckBox FontSize="16" Content="Пепперони" Margin="0,0,0,5"/>
        </StackPanel>

        <TextBlock Text="Количество:" FontSize="20" Margin="206,272,-146,0" VerticalAlignment="Top"/>
        <StackPanel Orientation="Horizontal" Margin="346,277,-146,0" VerticalAlignment="Top">
            <Slider Minimum="1" Maximum="10" Value="1" Width="200" IsSnapToTickEnabled="True" TickFrequency="1"/>
            <TextBlock Text="штук" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="Комментарий к заказу:" FontSize="20" Margin="206,332,-146,0" VerticalAlignment="Top"/>
        <TextBox MaxLength="200" 
             AcceptsReturn="True" 
             CharacterCasing="Upper" 
             HorizontalScrollBarVisibility="Visible" 
             VerticalScrollBarVisibility="Visible" 
             Margin="154,392,110,236"/>

        <Button Content="Оформить заказ" 
            FontSize="20" 
            FontFamily="Georgia" 
            FontWeight="Bold" 
            FontStyle="Italic" 
            HorizontalContentAlignment="Center" 
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,551,0,0" 
            Width="250" 
            Height="50"
            Opacity="0.9"/>
    </Grid>
</Window>
